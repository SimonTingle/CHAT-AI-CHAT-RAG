// Memory endpoints with error handling
app.post('/remember', authenticateUser, async (req, res) => {
    try {
        const errors = validateRequestBody(req.body, ['key', 'value']);
        if (errors.length > 0) {
            return safeJson(res, 400, { error: 'Validation failed', details: errors });
        }

        const { userId = 'default', key, value } = req.body;
        const sanitizedKey = sanitizeInput(key);
        const sanitizedValue = sanitizeInput(value);
        
        if (!sanitizedKey || sanitizedValue === undefined) {
            return safeJson(res, 400, { error: 'Key and value are required' });
        }

        await saveMemory(userId, sanitizedKey, sanitizedValue);
        safeJson(res, 200, { message: `Remembered ${sanitizedKey}: ${sanitizedValue}` });
    } catch (error) {
        console.error('🚨 Memory save error:', error);
        safeJson(res, 500, { error: 'Failed to remember information' });
    }
});

