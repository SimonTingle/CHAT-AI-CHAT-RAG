// CHAT ENDPOINT with comprehensive error handling
app.post('/chat', authenticateUser, async (req, res) => {
    const startTime = Date.now();
    
    try {
        // Validate request
        const errors = validateRequestBody(req.body, ['prompt']);
        if (errors.length > 0) {
            return safeJson(res, 400, { error: 'Validation failed', details: errors });
        }

        const { prompt, userId = 'default' } = req.body;
        const sanitizedPrompt = sanitizeInput(prompt);
        
        if (!sanitizedPrompt) {
            return safeJson(res, 400, { error: 'Prompt is required and must be a non-empty string' });
        }

        console.log(`💬 Chat request from user ${userId}: ${sanitizedPrompt.substring(0, 50)}...`);

        // Load memory and history with error boundaries
        let memoryFacts = [];
        let history = [];
        
        try {
            memoryFacts = await getMemory(userId);
            history = await getChatHistory(userId);
        } catch (error) {
            console.warn(`⚠️ Failed to load memory/history for user ${userId}:`, error.message);
            memoryFacts = [];
            history = [];
        }
        
        // RAG context with error handling
        let context = '';
        if (vectorStore) {
            try {
                context = await queryVectorStore(sanitizedPrompt, vectorStore) || '';
            } catch (error) {
                console.warn('⚠️ RAG query failed:', error.message);
                context = '';
            }
        }

        // Build prompt with memory and context
        const memoryContext = Array.isArray(memoryFacts) 
            ? memoryFacts.map(f => `${f.key}: ${f.value}`).join('\n')
            : '';
            
        const fullPrompt = `Known facts:\n${memoryContext}\n\nContext: ${context}\nUser: ${sanitizedPrompt}`;

        // Save user message with error handling
        try {
            await saveMessage(userId, 'user', sanitizedPrompt);
        } catch (error) {
            console.error(`❌ Failed to save user message for ${userId}:`, error.message);
        }

        // Enhanced Ollama call with comprehensive error handling
        let aiResponse = 'Sorry, I encountered an error. Please try again.';
        let ollamaSuccess = false;

        try {
            console.log(`📤 Sending to Ollama: ${OLLAMA_MODEL}`);
            
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 30000);
            
            const response = await fetch(`${OLLAMA_URL}/api/generate`, {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({
                    model: OLLAMA_MODEL,
                    prompt: fullPrompt,
                    stream: false,
                    options: {
                        temperature: 0.7,
                        top_p: 0.9,
                        stop: []
                    }
                }),
                signal: controller.signal
            });
            
            clearTimeout(timeoutId);
            
            if (!response.ok) {
                const errorText = await response.text().catch(() => 'Unknown error');
                const errorMessage = `Ollama request failed: ${response.status} ${errorText}`;
                console.error('❌', errorMessage);
                throw new Error(errorMessage);
            }
            
            const data = await response.json();
            aiResponse = data.response || '[No response from model]';
            ollamaSuccess = true;
            console.log('✅ Ollama response received');

        } catch (error) {
            console.error('❌ Ollama communication error:', error.message);
            
            if (error.name === 'AbortError') {
                aiResponse = 'The request timed out. Please try again.';
            } else {
                aiResponse = 'I apologize, but I am having trouble connecting to the AI service. Please check if Ollama is running.';
            }
        }

        // Save AI response with error handling
        try {
            await saveMessage(userId, 'assistant', aiResponse);
        } catch (error) {
            console.error(`❌ Failed to save AI response for ${userId}:`, error.message);
        }

        // Log chat with error handling
        try {
            fs.appendFileSync(
                path.join(LOG_DIR, 'chat.log'),
                `[${new Date().toISOString()}] User ${userId}: ${sanitizedPrompt} -> ${aiResponse}\n`
            );
        } catch (error) {
            console.error('❌ Failed to log chat:', error.message);
        }

        const responseTime = Date.now() - startTime;
        safeJson(res, 200, { 
            reply: aiResponse,
            responseTime: `${responseTime}ms`,
            ollamaSuccess
        });
        
    } catch (error) {
        console.error('🚨 Chat endpoint error:', error);
        
        // Log error to file
        try {
            fs.appendFileSync(
                path.join(LOG_DIR, 'errors.log'),
                `[${new Date().toISOString()}] Chat error: ${error.message}\n${error.stack}\n\n`
            );
        } catch (logError) {
            console.error('❌ Failed to log error:', logError.message);
        }
        
        safeJson(res, 500, { 
            error: 'Chat processing failed',
            message: process.env.NODE_ENV === 'development' ? error.message : 'Something went wrong'
        });
    }
});

// DOCUMENT UPLOAD ENDPOINT with robust error handling
app.post('/api/documents', authenticateUser, async (req, res) => {
    try {
        // Validate request
        const errors = validateRequestBody(req.body, ['text']);
        if (errors.length > 0) {
            return safeJson(res, 400, { error: 'Validation failed', details: errors });
        }

        const { text, metadata = {}, userId = 'default' } = req.body;
        const sanitizedText = sanitizeInput(text);
        
        if (!sanitizedText) {
            return safeJson(res, 400, { error: 'Document text is required' });
        }

        // Check if vector store is initialized
        if (!vectorStore) {
            return safeJson(res, 503, { error: 'Vector store not ready. Please try again in a moment.' });
        }

        console.log(`📄 Processing document upload for user ${userId}`);

        const success = await addDocument(sanitizedText, metadata, vectorStore);
        
        if (success) {
            // Log the document addition
            try {
                fs.appendFileSync(
                    path.join(LOG_DIR, 'documents.log'),
                    `[${new Date().toISOString()}] User ${userId} added: ${metadata?.fileName || 'unknown'}\n`
                );
            } catch (error) {
                console.error('❌ Failed to log document upload:', error.message);
            }
            
            safeJson(res, 200, { 
                success: true, 
                message: 'Document added to knowledge base',
                documentId: metadata.fileName 
            });
        } else {
            safeJson(res, 500, { error: 'Failed to process document' });
        }
    } catch (error) {
        console.error('🚨 Document upload error:', error);
        
        // Log error to file
        try {
            fs.appendFileSync(
                path.join(LOG_DIR, 'errors.log'),
                `[${new Date().toISOString()}] Document upload error: ${error.message}\n${error.stack}\n\n`
            );
        } catch (logError) {
            console.error('❌ Failed to log error:', logError.message);
        }
        
        safeJson(res, 500, { 
            error: 'Document upload failed',
            message: process.env.NODE_ENV === 'development' ? error.message : 'Something went wrong'
        });
    }
});

