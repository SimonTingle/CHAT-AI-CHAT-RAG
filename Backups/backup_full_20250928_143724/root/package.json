{
  "name": "chat-ai-chat-rag",
  "version": "1.0.0",
  "description": "AI Chatbot with RAG and Memory - Clean Version",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && nodemon server.js",
    "dev:frontend": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "setup": "npm install && cd client && npm install && cd ../backend && npm install",
    "start": "node backend/server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "clean": "rm -rf node_modules client/node_modules backend/node_modules"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.11.0",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.19.2",
    "node-fetch": "^2.7.0",
    "ollama": "^0.5.9",
    "sqlite3": "^5.1.7",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "ai",
    "chatbot",
    "rag",
    "memory",
    "ollama"
  ],
  "author": "Simon Tingle",
  "license": "ISC"
}
