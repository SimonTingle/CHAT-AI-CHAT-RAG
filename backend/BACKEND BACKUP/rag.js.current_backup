const fs = require('fs').promises;
const path = require('path');

// Simple in-memory vector store (replace with ChromaDB, Pinecone, etc. in production)
let vectorStore = {
  documents: [],
  vectors: []
};

async function initVectorStore() {
  console.log('Initializing vector store');
  // Create vectorstore directory if it doesn't exist
  try {
    await fs.mkdir(path.join(__dirname, 'vectorstore'), { recursive: true });
    // Load existing documents if any
    const docsPath = path.join(__dirname, 'vectorstore', 'documents.json');
    try {
      const data = await fs.readFile(docsPath, 'utf8');
      vectorStore = JSON.parse(data);
      console.log(`Loaded ${vectorStore.documents.length} documents from storage`);
    } catch (err) {
      console.log('No existing vector store found, starting fresh');
    }
  } catch (err) {
    console.error('Error initializing vector store:', err);
  }
  return vectorStore;
}

async function saveVectorStore() {
  try {
    const docsPath = path.join(__dirname, 'vectorstore', 'documents.json');
    await fs.writeFile(docsPath, JSON.stringify(vectorStore, null, 2));
  } catch (err) {
    console.error('Error saving vector store:', err);
  }
}

// Simple text-to-vector simulation (in real implementation, use embeddings)
function textToVector(text) {
  // This is a simple hash-based approach for demo purposes
  // In real implementation, use proper embedding models
  const words = text.toLowerCase().split(/\s+/);
  const vector = new Array(384).fill(0); // Simulate 384-dimensional vector
  
  words.forEach((word, index) => {
    let hash = 0;
    for (let i = 0; i < word.length; i++) {
      hash = ((hash << 5) - hash + word.charCodeAt(i)) & 0xffffffff;
    }
    const vectorIndex = Math.abs(hash) % 384;
    vector[vectorIndex] += 1;
  });
  
  return vector;
}

async function addDocument(text, metadata, vectorStore) {
  try {
    console.log(`Adding document: ${text.substring(0, 50)}...`);
    
    const vector = textToVector(text);
    const document = {
      id: Date.now().toString(),
      text: text,
      metadata: metadata || {},
      createdAt: new Date().toISOString(),
      vector: vector
    };
    
    vectorStore.documents.push(document);
    vectorStore.vectors.push(vector);
    
    // Save to persistent storage
    await saveVectorStore();
    
    console.log(`Document added successfully. Total documents: ${vectorStore.documents.length}`);
    return true;
  } catch (error) {
    console.error('Error adding document:', error);
    return false;
  }
}

async function queryVectorStore(prompt, vectorStore) {
  try {
    console.log(`Querying vector store with: ${prompt}`);
    
    if (vectorStore.documents.length === 0) {
      return "No documents available to search.";
    }
    
    const queryVector = textToVector(prompt);
    
    // Simple similarity search (cosine similarity simulation)
    let bestMatch = null;
    let bestScore = -1;
    
    for (let i = 0; i < vectorStore.documents.length; i++) {
      const doc = vectorStore.documents[i];
      const score = calculateSimilarity(queryVector, doc.vector);
      
      if (score > bestScore) {
        bestScore = score;
        bestMatch = doc;
      }
    }
    
    if (bestMatch && bestScore > 0.1) { // Threshold for relevance
      return `Relevant document found:\n${bestMatch.text}\n\nMetadata: ${JSON.stringify(bestMatch.metadata)}`;
    } else {
      return "No relevant documents found for your query.";
    }
  } catch (error) {
    console.error('Error querying vector store:', error);
    return "Error searching documents.";
  }
}

function calculateSimilarity(vec1, vec2) {
  // Simple cosine similarity calculation
  let dotProduct = 0;
  let mag1 = 0;
  let mag2 = 0;
  
  for (let i = 0; i < vec1.length; i++) {
    dotProduct += vec1[i] * vec2[i];
    mag1 += vec1[i] * vec1[i];
    mag2 += vec2[i] * vec2[i];
  }
  
  mag1 = Math.sqrt(mag1);
  mag2 = Math.sqrt(mag2);
  
  if (mag1 === 0 || mag2 === 0) return 0;
  
  return dotProduct / (mag1 * mag2);
}

async function getVectorStoreStats(vectorStore) {
  return { 
    documentCount: vectorStore.documents.length,
    vectorCount: vectorStore.vectors.length,
    dimensions: vectorStore.vectors.length > 0 ? vectorStore.vectors[0].length : 0
  };
}

module.exports = { initVectorStore, queryVectorStore, addDocument, getVectorStoreStats };
